# CORS
# Comma-separated list of allowed frontend origins.
# In development, defaults to http://localhost:5173 and http://localhost:4173 if not set.
# In production, MUST be set to your actual frontend URL (wildcard '*' is blocked in production).
# If the backend serves the frontend (recommended), set this to your domain:
CORS_ORIGIN=https://reelsmx.fun

# Frontend dist path (optional, defaults to ../frontend/dist relative to backend/)
# FRONTEND_DIST=/absolute/path/to/frontend/dist

# OTP (in production, integrate SMS provider)
OTP_EXPIRY_MINUTES=10
