# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=lottery_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
# Comma-separated list of allowed frontend origins.
# In development, defaults to http://localhost:5173 and http://localhost:4173 if not set.
# In production, MUST be set to your actual frontend URL (wildcard '*' is blocked in production).
CORS_ORIGIN=http://localhost:5173

# OTP (in production, integrate SMS provider)
OTP_EXPIRY_MINUTES=10
